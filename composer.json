    "keywords": [
        "phpbb",
        "extension",
        "notifications",
        "prune",
        "database",
        "optimize"
    ],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "phpBB Modders",
            "email": "board@phpbbmodders.com",
            "homepage": "https://www.phpbbmodders.com/",
            "role": "Extension Developer"
        }
    ],
    "require": {
        "php": ">=8.1.0",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpbb/epv": "dev-master"
    },
    "extra": {
        "display-name": "Prune Notifications",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.19"
        }
